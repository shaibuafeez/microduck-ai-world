        <light name="key"  pos="1.8 -2.2 3.0" dir="-0.45 0.55 -0.75" directional="true"
               diffuse="0.85 0.83 0.78" specular="0.25 0.25 0.25" castshadow="true" />
        <light name="fill" pos="-2.5 2.0 2.0" dir="0.6 -0.5 -0.62" directional="true"
               diffuse="0.22 0.24 0.28" specular="0 0 0" castshadow="false" />
        <geom name="floor" size="0 0 0.05" pos="0 0 0" type="plane" material="groundplane" />

