<mujoco model="scene_obstacles">
    <include file="robot_allcollisions_cam.xml" />
    <!-- 70mm / 15g ball — the same body the kick policies were trained on.
         Its freejoint adds 7 qpos, so every keyframe below is extended to match. -->
    <include file="ball.xml" />

    <visual>
        <!-- Softer key light + real ambient, so shading comes from the scene lights
             rather than a flat headlight washing everything out. -->
        <headlight diffuse="0.25 0.25 0.25" ambient="0.22 0.22 0.24" specular="0.05 0.05 0.05" />
        <rgba haze="0.78 0.83 0.89 1" />
        <global azimuth="140" elevation="-22" offwidth="1920" offheight="1080" />
        <quality shadowsize="8192" offsamples="8" />
        <map fogstart="14" fogend="55" shadowclip="3" shadowscale="1.2" />
    </visual>

    <asset>
        <!-- Procedural sky cubemap from make_sky_texture.py: clouds sampled from one
             periodic 3D volume (continuous across face edges) and three hazed
             mountain ranges baked in at the horizon. Distant terrain as texture is
             free; the same silhouette as geometry would be collidable triangles. -->
        <texture type="skybox" name="sky"
            fileright="sky_right.png" fileleft="sky_left.png"
            filefront="sky_front.png" fileback="sky_back.png"
            fileup="sky_up.png"       filedown="sky_down.png" />
        <!-- Real concrete: seamless 1024px texture generated by make_ground_texture.py.
             FFT-filtered noise is periodic, so it tiles with no visible seam. -->
        <texture type="2d" name="groundplane" file="ground_concrete.png" />
        <!-- texrepeat 0.6 => one 1024px tile per ~1.7 m, so the duck (0.25 m) sees
             fine aggregate rather than a repeating pattern. -->
        <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="0.6 0.6"
            reflectance="0.02" specular="0.12" shininess="0.08" />
        <!-- Village palette: plaster walls, terracotta/slate roofs. -->
        <material name="wall0" rgba="0.86 0.83 0.76 1" specular="0.10" shininess="0.05"/>
        <material name="wall1" rgba="0.80 0.75 0.68 1" specular="0.10" shininess="0.05"/>
        <material name="wall2" rgba="0.72 0.70 0.66 1" specular="0.10" shininess="0.05"/>
        <material name="roof0" rgba="0.48 0.25 0.19 1" specular="0.18" shininess="0.12"/>
        <material name="roof1" rgba="0.38 0.22 0.18 1" specular="0.18" shininess="0.12"/>
        <material name="roof2" rgba="0.34 0.34 0.36 1" specular="0.18" shininess="0.12"/>
        <material name="door"  rgba="0.34 0.24 0.17 1" specular="0.20" shininess="0.15"/>
        <material name="glass" rgba="0.24 0.32 0.38 1" specular="0.85" shininess="0.75"
                  reflectance="0.25"/>
        <material name="bark"  rgba="0.31 0.25 0.20 1" specular="0.06"/>
        <material name="leaf"  rgba="0.26 0.38 0.24 1" specular="0.10" shininess="0.06"/>
        <material name="goal" rgba="0.92 0.93 0.95 1" specular="0.4" shininess="0.3"/>
        <material name="goalline" rgba="0.95 0.95 0.96 1"/>
        <material name="obstacle" rgba="0.50 0.46 0.41 1" reflectance="0.02" specular="0.15" shininess="0.1"/>
        <material name="ramp"     rgba="0.44 0.44 0.46 1" reflectance="0.02" specular="0.15" shininess="0.1"/>
        <material name="debris"   rgba="0.52 0.40 0.34 1" reflectance="0.02" specular="0.15" shininess="0.1"/>
        <material name="rough"    rgba="0.47 0.45 0.43 1" reflectance="0.02" specular="0.12" shininess="0.08"/>
    </asset>

