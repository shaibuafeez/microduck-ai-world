<!-- ============================= aaa_terrain_body.xml =============================
     TERRAIN agent.  Floor, water, inlays, and the ground OUTSIDE the walls.
     terrain_floor is the ONLY collidable geom in this fragment and the only geom in
     the whole scene that keeps default collision.  Everything else is a flat decal:
     inside the court at z <= 2.6 mm, because at 12 cm eye height a thicker lip would
     show its own edge; outside the walls at 0.3 mm.
     Nothing here enters the r <= 0.9 m spawn apron. -->

<!-- The walkable world.  Infinite plane: keeps haze alive, keeps the horizon at 50% of
     frame, and keeps the duck's contact set identical to training. -->
<geom name="terrain_floor" size="0 0 0.05" pos="0 0 0" type="plane" material="terrain_ground"/>

<!-- ===== OUTSIDE THE WALLS =====
     The paving has to STOP.  Without this the court's flagstone tiles the infinite
     plane to the horizon in every direction and checkerboards at the tile pitch
     across the lower two thirds of the establishing shot.  An inner ring of sand and
     builders' spoil runs from the wall foot to 13 m, an outer ring in the aerial-
     perspective variant carries it to 42 m, and a scatter of tongues breaks the
     boundary so paving and dirt interlock instead of meeting on a ruled line. -->
<geom name="terrain_out_n" type="box" pos="0 8.21 0.0003" size="13 4.79 0.0003" material="terrain_apron" contype="0" conaffinity="0"/>
<geom name="terrain_out_s" type="box" pos="0 -8.21 0.0003" size="13 4.79 0.0003" material="terrain_apron" contype="0" conaffinity="0"/>
