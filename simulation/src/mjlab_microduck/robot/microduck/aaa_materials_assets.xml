<!-- aaa_materials_assets.xml - generated by scripts/aaa/materials.py.
     THE WATER COURT shared material library. Do not hand-edit.
     Textures are LINEAR and carry their palette albedo as their mean, so
     every material is rgba="1 1 1 1"; per-geom rgba MULTIPLIES it, which
     is how you get the bible's +/-6% per-instance tint. -->

<texture name="materials_tex_canvas" type="2d" file="materials_tex_canvas.png"/>
<texture name="materials_tex_glass" type="2d" file="materials_tex_glass.png"/>
<texture name="materials_tex_ground" type="2d" file="materials_tex_ground.png"/>
<texture name="materials_tex_ground_damp" type="2d" file="materials_tex_ground_damp.png"/>
<texture name="materials_tex_iron" type="2d" file="materials_tex_iron.png"/>
<texture name="materials_tex_lamp" type="2d" file="materials_tex_lamp.png"/>
<texture name="materials_tex_lapis" type="2d" file="materials_tex_lapis.png"/>
<texture name="materials_tex_olive" type="2d" file="materials_tex_olive.png"/>
<texture name="materials_tex_paint" type="2d" file="materials_tex_paint.png"/>
<texture name="materials_tex_petrol" type="2d" file="materials_tex_petrol.png"/>
<texture name="materials_tex_plaster" type="2d" file="materials_tex_plaster.png"/>
<texture name="materials_tex_plaster_far" type="2d" file="materials_tex_plaster_far.png"/>
<texture name="materials_tex_plaster_mid" type="2d" file="materials_tex_plaster_mid.png"/>
<texture name="materials_tex_rose" type="2d" file="materials_tex_rose.png"/>
<texture name="materials_tex_ruin" type="2d" file="materials_tex_ruin.png"/>
<texture name="materials_tex_sand" type="2d" file="materials_tex_sand.png"/>
<texture name="materials_tex_stone" type="2d" file="materials_tex_stone.png"/>
<texture name="materials_tex_stone_far" type="2d" file="materials_tex_stone_far.png"/>
<texture name="materials_tex_terra" type="2d" file="materials_tex_terra.png"/>
<texture name="materials_tex_wood" type="2d" file="materials_tex_wood.png"/>

<!-- court flagstone, HERO. one 1024px tile per 0.90 m => 12.9 cm stones -->
<material name="materials_ground" texture="materials_tex_ground" texuniform="true" texrepeat="1.11 1.11" rgba="1 1 1 1" specular="0.1" shininess="0.08"/>
<!-- puddles, rill, basin. registers with aaa_ground. keep geoms 0.8 mm thin -->
<material name="materials_ground_wet" texture="materials_tex_ground_damp" texuniform="true" texrepeat="1.11 1.11" rgba="1 1 1 1" specular="0.5" shininess="0.75" reflectance="0.22"/>
<!-- walls and column shafts, 0-3 m -->
<material name="materials_plaster" texture="materials_tex_plaster" texuniform="true" texrepeat="0.625 0.625" rgba="1 1 1 1" specular="0.06" shininess="0.04"/>
<!-- same, 3-6 m. aerial perspective baked in -->
<material name="materials_plaster_mid" texture="materials_tex_plaster_mid" texuniform="true" texrepeat="0.625 0.625" rgba="1 1 1 1" specular="0.05" shininess="0.04"/>
<!-- same, >6 m -->
<material name="materials_plaster_far" texture="materials_tex_plaster_far" texuniform="true" texrepeat="0.625 0.625" rgba="1 1 1 1" specular="0.04" shininess="0.03"/>
<!-- capitals, plinths, copings, fountain rim -->
<material name="materials_stone" texture="materials_tex_stone" texuniform="true" texrepeat="1.8 1.8" rgba="1 1 1 1" specular="0.1" shininess="0.06"/>
<!-- same, >6 m -->
<material name="materials_stone_far" texture="materials_tex_stone_far" texuniform="true" texrepeat="1.8 1.8" rgba="1 1 1 1" specular="0.06" shininess="0.04"/>
<!-- the SUN wall ONLY. texuniform=false: v spans the wall height exactly once -->
<material name="materials_rose" texture="materials_tex_rose" texuniform="false" texrepeat="14 1" rgba="1 1 1 1" specular="0.07" shininess="0.05"/>
<!-- the SHADOW wall ONLY. salt bloom rises from the base -->
<material name="materials_petrol" texture="materials_tex_petrol" texuniform="false" texrepeat="14 1" rgba="1 1 1 1" specular="0.14" shininess="0.1"/>
<!-- pots, amphorae. throw ridges band around the form -->
<material name="materials_terra" texture="materials_tex_terra" texuniform="true" texrepeat="3.33 3.33" rgba="1 1 1 1" specular="0.1" shininess="0.06"/>
<!-- all vegetation -->
<material name="materials_olive" texture="materials_tex_olive" texuniform="true" texrepeat="4 4" rgba="1 1 1 1" specular="0.12" shininess="0.08"/>
<!-- raw rusted ironwork, brackets, rings -->
<material name="materials_iron" texture="materials_tex_iron" texuniform="true" texrepeat="3.33 3.33" rgba="1 1 1 1" specular="0.3" shininess="0.35"/>
<!-- THE ONE saturated object. use on exactly one prop, in shade -->
<material name="materials_lapis" texture="materials_tex_lapis" texuniform="true" texrepeat="4 4" rgba="1 1 1 1" specular="0.45" shininess="0.55" reflectance="0.05"/>
<!-- lamps, curb strips, beacon -->
<material name="materials_emit" rgba="1 0.84 0.56 1" specular="0" shininess="0" emission="0.95"/>
<!-- long curb runs that would otherwise blow out -->
<material name="materials_emit_low" rgba="1 0.84 0.56 1" specular="0" shininess="0" emission="0.45"/>
<!-- lamp lens with a hot core. one lens per geom face -->
<material name="materials_emit_lamp" texture="materials_tex_lamp" texuniform="false" texrepeat="1 1" rgba="1 1 1 1" specular="0" shininess="0" emission="0.95"/>
<!-- weathered timber: crates, ladder, cart, broom -->
<material name="materials_wood" texture="materials_tex_wood" texuniform="true" texrepeat="1.43 1.43" rgba="1 1 1 1" specular="0.08" shininess="0.06"/>
<!-- sacking and awnings. woven relief baked from a Sobel normal -->
<material name="materials_canvas" texture="materials_tex_canvas" texuniform="true" texrepeat="4.5 4.5" rgba="1 1 1 1" specular="0.05" shininess="0.04"/>
<!-- red-lead painted steel chipping back to rust -->
<material name="materials_paint" texture="materials_tex_paint" texuniform="true" texrepeat="3.33 3.33" rgba="1 1 1 1" specular="0.34" shininess="0.42"/>
<!-- drifted dust, spilled grain -->
<material name="materials_sand" texture="materials_tex_sand" texuniform="true" texrepeat="1.67 1.67" rgba="1 1 1 1" specular="0.06" shininess="0.05"/>
<!-- render fallen off a rubble core. the west ruin stumps -->
<material name="materials_ruin" texture="materials_tex_ruin" texuniform="true" texrepeat="1 1" rgba="1 1 1 1" specular="0.09" shininess="0.06"/>
<!-- grimy glazing. alpha lives in rgba, never in the PNG -->
<material name="materials_glass" texture="materials_tex_glass" texuniform="true" texrepeat="2 2" rgba="1 1 1 0.34" specular="0.85" shininess="0.9" reflectance="0.06"/>
